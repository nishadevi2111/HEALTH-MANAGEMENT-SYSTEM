    void enter(JComponent a,JComponent b){
        a.getInputMap(JComponent.WHEN_FOCUSED).put(KeyStroke.getKeyStroke("ENTER"),"next");
        a.getActionMap().put("next",new AbstractAction(){public void actionPerformed(ActionEvent e){b.requestFocusInWindow();}});
    }
    boolean yes(JComboBox<String> x){return "Yes".equals(x.getSelectedItem());}
    void react(){
        boolean bad=false,any=false;
        try{if(!water.getText().isEmpty()){any=true;if(Double.parseDouble(water.getText())<15.5)bad=true;}
            if(!walk.getText().isEmpty()){any=true;if(Double.parseDouble(walk.getText())<5)bad=true;}
        }catch(Exception e){any=true;bad=true;}
        if(sleep.getSelectedIndex()>0){any=true;if(!sleep.getSelectedItem().equals("Good"))bad=true;}
        if(mood.getSelectedIndex()>0){any=true;if(mood.getSelectedIndex()>2)bad=true;}
        if(food.getSelectedIndex()>0){any=true;if(!food.getSelectedItem().equals("Vegetables"))bad=true;}
        for(JComboBox<String> x:new JComboBox[]{face,moist,oil,massage})if(x.getSelectedIndex()>0){any=true;if(!yes(x))bad=true;}
        if(doctor!=null)doctor.setMood(!bad,any);
    }

    void analyze(){
        double w,k;
        try{w=Double.parseDouble(water.getText());k=Double.parseDouble(walk.getText());
            if(w<0||k<0||sleep.getSelectedIndex()==0||mood.getSelectedIndex()==0||food.getSelectedIndex()==0)throw new Exception();
            for(JComboBox<String> x:new JComboBox[]{face,moist,oil,massage})if(x.getSelectedIndex()==0)throw new Exception();
        }catch(Exception e){JOptionPane.showMessageDialog(this,"Complete every field and enter valid numbers.");return;}
        score[0]=w>=15.5?10:0;score[1]=k>=5?10:0;score[2]=sleep.getSelectedItem().equals("Good")?10:0;
        score[3]=mood.getSelectedIndex()<=2?10:0;score[4]=food.getSelectedItem().equals("Junk Food")?0:10;
        score[5]=food.getSelectedItem().equals("Vegetables")?10:0;score[6]=yes(face)?10:0;score[7]=yes(moist)?10:0;
        score[8]=yes(oil)?10:0;score[9]=yes(massage)?10:0;total=0;for(int x:score)total+=x;save();analysisPage();cl.show(root,"analysis");
    }
    void save(){
        try(PrintWriter w=new PrintWriter(new FileWriter("health.txt",true))){w.println(user.getText().trim()+"|"+LocalDate.now()+"|"+(int)total);}catch(Exception e){}
    }

