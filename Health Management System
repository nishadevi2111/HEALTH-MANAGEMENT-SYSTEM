    class Graph extends JPanel{
        Graph(){setBackground(bg);}
        protected void paintComponent(Graphics g){
            super.paintComponent(g);Graphics2D a=(Graphics2D)g.create();
            a.setRenderingHint(RenderingHints.KEY_ANTIALIASING,RenderingHints.VALUE_ANTIALIAS_ON);
            int left=55,top=35,bottom=getHeight()-115,width=getWidth()-100,chartH=bottom-top;
            a.setFont(new Font("Arial",Font.BOLD,12));
            for(int n=0;n<=10;n+=2){int y=bottom-chartH*n/10;a.setColor(new Color(210,220,225));a.drawLine(left,y,left+width,y);a.setColor(navy);a.drawString(""+n,left-25,y+5);}
            int slot=width/10,bar=Math.max(12,slot/2);
            for(int i=0;i<10;i++){
                int h=chartH*score[i]/10,x=left+i*slot+(slot-bar)/2,y=bottom-h;
                a.setColor(colors[i]);a.fillRoundRect(x,y,bar,h,9,9);
                a.setColor(navy);a.setFont(new Font("Arial",Font.BOLD,11));a.drawString(score[i]+"/10",x-3,y-7);
                a.setFont(new Font("Arial",Font.PLAIN,11));FontMetrics fm=a.getFontMetrics();
                int tx=x+bar/2-fm.stringWidth(labels[i])/2;a.drawString(labels[i],tx,bottom+20);
            }
            a.setColor(navy);a.setFont(new Font("Arial",Font.BOLD,14));a.drawString("Category Scores",left+width/2-55,getHeight()-8);a.dispose();
        }
    }

    class Doctor extends JPanel{
        boolean happy=true,active=false;
        Doctor(int w,int h){setPreferredSize(new Dimension(w,h));setOpaque(false);}
        void setMood(boolean h,boolean a){happy=h;active=a;repaint();}
        protected void paintComponent(Graphics g){
            super.paintComponent(g);Graphics2D a=(Graphics2D)g.create();
            a.setRenderingHint(RenderingHints.KEY_ANTIALIASING,RenderingHints.VALUE_ANTIALIAS_ON);
            int x=getWidth()/2-48,y=8,hx=x-10;
            a.setColor(new Color(75,43,30));a.fillOval(hx-5,y,105,112);
            a.setColor(new Color(255,220,185));a.fillOval(hx+8,y+20,78,88);
            a.setColor(new Color(75,43,30));a.fillArc(hx-2,y-4,100,65,0,180);
            a.fillOval(hx-3,y+38,18,100);a.fillOval(hx+80,y+38,18,100);
            a.setColor(Color.BLACK);a.fillOval(hx+29,y+55,6,7);a.fillOval(hx+60,y+55,6,7);
            a.setColor(new Color(210,120,130));a.fillOval(hx+17,y+75,12,7);a.fillOval(hx+68,y+75,12,7);
            a.setColor(new Color(140,60,65));a.setStroke(new BasicStroke(2));
            if(!active)a.drawLine(hx+37,y+91,hx+57,y+91);else if(happy)a.drawArc(hx+33,y+79,30,20,200,140);else a.drawArc(hx+33,y+94,30,18,20,140);
            int coatY=y+112;a.setColor(Color.WHITE);a.fillRoundRect(x-22,coatY,118,115,16,16);
            a.setColor(new Color(100,120,145));a.drawRoundRect(x-22,coatY,118,115,16,16);
            a.setColor(new Color(35,105,145));a.drawLine(x+35,coatY,x+35,coatY+112);a.drawLine(x+15,coatY,x+35,coatY+22);a.drawLine(x+55,coatY,x+35,coatY+22);
            a.setColor(new Color(30,145,155));a.setStroke(new BasicStroke(3));a.drawArc(x+8,coatY+30,55,58,180,180);
            a.setColor(new Color(75,95,115));a.fillOval(x+7,coatY+57,13,13);a.setColor(new Color(50,100,155));a.fillRoundRect(x+70,coatY+55,19,29,3,3);
            a.setColor(Color.WHITE);a.setFont(new Font("Arial",Font.BOLD,7));a.drawString("MD",x+74,coatY+67);
            a.setColor(navy);a.setFont(new Font("Arial",Font.BOLD,14));a.drawString("Doctor Buddy",x-13,coatY+139);a.dispose();
        }
    }
