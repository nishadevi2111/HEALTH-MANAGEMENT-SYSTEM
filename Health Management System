    void register(){
        JTextField id=new JTextField(15);JPasswordField pw=new JPasswordField(15),confirm=new JPasswordField(15);
        JPanel form=new JPanel(new GridLayout(3,2,8,10));
        form.add(new JLabel("Create User ID"));form.add(id);
        form.add(new JLabel("Create Password"));form.add(pw);
        form.add(new JLabel("Confirm Password"));form.add(confirm);
        int result=JOptionPane.showConfirmDialog(this,form,"Create New Account",JOptionPane.OK_CANCEL_OPTION);
        if(result!=JOptionPane.OK_OPTION)return;
        String name=id.getText().trim(),password=new String(pw.getPassword());
        if(name.isEmpty()||password.isEmpty()){JOptionPane.showMessageDialog(this,"Enter both User ID and Password.");return;}
        if(!password.equals(new String(confirm.getPassword()))){JOptionPane.showMessageDialog(this,"Passwords do not match.");return;}
        if(name.contains("|")||password.contains("|")){JOptionPane.showMessageDialog(this,"Do not use | in your details.");return;}
        if(accountExists(name)){JOptionPane.showMessageDialog(this,"This User ID already exists. Choose another.");return;}
        try(PrintWriter out=new PrintWriter(new FileWriter("account.txt",true))){
            out.println(name+"|"+password);
            JOptionPane.showMessageDialog(this,"Registration successful! You can now log in.");
            user.setText(name);pass.setText("");pass.requestFocusInWindow();
        }catch(Exception e){JOptionPane.showMessageDialog(this,"Unable to save account.");}
    }

    boolean accountExists(String name){
        try(BufferedReader r=new BufferedReader(new FileReader("account.txt"))){
            String line;while((line=r.readLine())!=null){
                String[] a=line.split("\\|",-1);
                if(a.length==2&&a[0].equalsIgnoreCase(name))return true;
            }
        }catch(Exception e){}
        return false;
    }

    void login(){
        String name=user.getText().trim(),password=new String(pass.getPassword());
        boolean valid=false;
        try(BufferedReader r=new BufferedReader(new FileReader("account.txt"))){
            String line;while((line=r.readLine())!=null){
                String[] a=line.split("\\|",-1);
                if(a.length==2&&a[0].equals(name)&&a[1].equals(password)){valid=true;break;}
            }
        }catch(Exception e){}
        if(valid){homePage();cl.show(root,"home");}
        else JOptionPane.showMessageDialog(this,"Invalid User ID or Password. Please register or check your details.");
    }

